<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Core diagnostic variant deliberately omits NotificationListenerService.
         This isolates Play Protect sensitivity from the full notification feature set. -->
